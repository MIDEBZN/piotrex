---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
}

const { 
  title, 
  description = "Piotrex - Plombier chauffagiste agréé à Woluwe-Saint-Lambert et Bruxelles. Dépannage urgent 24h/7j, débouchage, réparation de fuites et rénovation de sanitaires.", 
  canonicalUrl 
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Primary Tags -->
    <title>{title} | Piotrex Plomberie Bruxelles</title>
    <meta name="title" content={`${title} | Piotrex Plomberie Bruxelles`} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="geo.region" content="BE-BRU" />
    <meta name="geo.placename" content="Woluwe-Saint-Lambert" />
    <meta name="geo.position" content="50.8430;4.4257" />
    <meta name="ICBM" content="50.8430, 4.4257" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={`${title} | Piotrex Plomberie`} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="fr_BE" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={`${title} | Piotrex Plomberie`} />
    <meta property="twitter:description" content={description} />

    <!-- Google Fonts Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Schema.org JSON-LD Plumber LocalBusiness -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "PlumbingService",
        "name": "Piotrex Plomberie Chauffage",
        "image": "https://piotrex.be/logo.png",
        "telephone": "+32 451 29 17 48",
        "emergencyTelephone": "+32 451 29 17 48",
        "email": "contact@piotrex.site",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Bd Brand Whitlock 14",
          "addressLocality": "Woluwe-Saint-Lambert",
          "postalCode": "1200",
          "addressRegion": "Bruxelles-Capitale",
          "addressCountry": "BE"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": 50.8430,
          "longitude": 4.4257
        },
        "openingHoursSpecification": [
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
            "opens": "00:00",
            "closes": "23:59"
          }
        ],
        "priceRange": "€€",
        "areaServed": [
          "Woluwe-Saint-Lambert",
          "Woluwe-Saint-Pierre",
          "Etterbeek",
          "Ixelles",
          "Schaerbeek",
          "Auderghem",
          "Evere",
          "Bruxelles-Ville"
        ]
      }
    </script>
  </head>
  <body>
    <!-- Top banner info -->
    <div class="header-topbar">
      <div class="container">
        <div class="topbar-info">
          <span>📍 <strong>Woluwe-Saint-Lambert (1200)</strong> & Région Bruxelles-Capitale</span>
          <span>⚡ <strong>Dépannage d'urgence 24h/7j</strong> en 30 minutes</span>
          <span>⭐ Plombier certifié & agréé</span>
        </div>
        <div>
          <a href="tel:+32451291748" style="color: #ffffff; font-weight: 700; text-decoration: none;">
            📞 Urgence directe : 0451 29 17 48
          </a>
        </div>
      </div>
    </div>

    <!-- Header navigation -->
    <header class="site-header">
      <div class="container">
        <a href="/" class="brand-logo" id="header-brand-logo" aria-label="Accueil Piotrex">
          <div class="brand-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
            </svg>
          </div>
          <div>
            <div class="brand-title">PIOTREX<span>.be</span></div>
            <span class="brand-subtitle">Plomberie & Chauffage</span>
          </div>
        </a>

        <button class="mobile-nav-toggle" id="mobileNavToggle" aria-label="Menu principal">
          <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>

        <ul class="nav-links" id="navLinks">
          <li><a href="/" class={`nav-link ${currentPath === '/' ? 'active' : ''}`} id="nav-home">Accueil</a></li>
          <li><a href="/services" class={`nav-link ${currentPath === '/services' || currentPath.startsWith('/services') ? 'active' : ''}`} id="nav-services">Services</a></li>
          <li><a href="/locations" class={`nav-link ${currentPath === '/locations' || currentPath.startsWith('/locations') ? 'active' : ''}`} id="nav-locations">Zones d'intervention</a></li>
          <li><a href="/about" class={`nav-link ${currentPath === '/about' ? 'active' : ''}`} id="nav-about">À propos</a></li>
          <li><a href="/contact" class={`nav-link ${currentPath === '/contact' ? 'active' : ''}`} id="nav-contact">Contact</a></li>
        </ul>

        <div class="nav-actions">
          <a href="tel:+32451291748" class="btn btn-emergency" id="nav-call-btn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            Appeler 24/7
          </a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div>
            <div class="brand-logo" style="margin-bottom: 1rem;">
              <div class="brand-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                  <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
                </svg>
              </div>
              <div class="brand-title">PIOTREX<span>.be</span></div>
            </div>
            <p style="color: var(--text-secondary); font-size: 0.95rem; margin-bottom: 1.5rem; max-width: 320px;">
              Votre artisan plombier de confiance à Woluwe-Saint-Lambert et sur l'ensemble de la région bruxelloise. Dépannage express, devis gratuit et travail garanti.
            </p>
            <div style="color: #38bdf8; font-weight: 600; font-size: 0.95rem;">
              📍 Bd Brand Whitlock 14, 1200 Woluwe-Saint-Lambert
            </div>
          </div>

          <div>
            <h3 class="footer-col-title">Nos Services</h3>
            <ul class="footer-links">
              <li><a href="/services#depannage">Dépannage d'urgence 24/7</a></li>
              <li><a href="/services#debouchage">Débouchage canalisations</a></li>
              <li><a href="/services#fuites">Recherche & réparation fuites</a></li>
              <li><a href="/services#chauffage">Chaudière & Chauffage</a></li>
              <li><a href="/services#sanitaire">Rénovation de salle de bain</a></li>
              <li><a href="/services#robinetterie">Changement robinetterie / WC</a></li>
            </ul>
          </div>

          <div>
            <h3 class="footer-col-title">Zones desservies</h3>
            <ul class="footer-links">
              <li><a href="/locations#woluwe-saint-lambert">Woluwe-Saint-Lambert</a></li>
              <li><a href="/locations#woluwe-saint-pierre">Woluwe-Saint-Pierre</a></li>
              <li><a href="/locations#etterbeek">Etterbeek</a></li>
              <li><a href="/locations#ixelles">Ixelles</a></li>
              <li><a href="/locations#schaerbeek">Schaerbeek</a></li>
              <li><a href="/locations#auderghem">Auderghem</a></li>
              <li><a href="/locations">Toutes les 19 communes</a></li>
            </ul>
          </div>

          <div>
            <h3 class="footer-col-title">Contact & Urgence</h3>
            <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 1rem;">
              Disponible 24 heures sur 24 et 7 jours sur 7 pour toutes vos urgences plomberie.
            </p>
            <div style="margin-bottom: 0.75rem;">
              <a href="tel:+32451291748" class="btn btn-emergency" style="width: 100%;">
                📞 0451 29 17 48
              </a>
            </div>
            <div>
              <a href="mailto:contact@piotrex.site" style="color: var(--text-secondary); font-size: 0.9rem; display: block; text-align: center;">
                ✉️ contact@piotrex.site
              </a>
            </div>
          </div>
        </div>

        <div class="footer-bottom">
          <div>
            &copy; {new Date().getFullYear()} Piotrex Plomberie. Tous droits réservés. TVA: BE0832799042.
          </div>
          <div style="display: flex; gap: 1.5rem;">
            <a href="/about">Mentions Légales</a>
            <a href="/contact">Devis Gratuit</a>
            <a href="/locations">Bruxelles & Environs</a>
          </div>
        </div>
      </div>
    </footer>

    <script>
      const toggle = document.getElementById('mobileNavToggle');
      const nav = document.getElementById('navLinks');
      if (toggle && nav) {
        toggle.addEventListener('click', () => {
          nav.classList.toggle('is-open');
        });
      }
    </script>
  </body>
</html>
