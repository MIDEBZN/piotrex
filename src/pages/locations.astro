---
import Layout from '../layouts/Layout.astro';

const communes = [
  {
    name: "Woluwe-Saint-Lambert",
    zip: "1200",
    slug: "woluwe-saint-lambert",
    delay: "15-25 min",
    hq: true,
    desc: "Notre siège d'intervention principal. Dépannage prioritaire à Roodebeek, Georges Henri, Tomberg, Marcel Thiry, Hof ten Berg et environs."
  },
  {
    name: "Woluwe-Saint-Pierre",
    zip: "1150",
    slug: "woluwe-saint-pierre",
    delay: "20-30 min",
    hq: false,
    desc: "Interventions rapides autour de Stockel, Montgomery, Val Duchesse, Place Dumon et Avenue de Tervueren."
  },
  {
    name: "Etterbeek",
    zip: "1040",
    slug: "etterbeek",
    delay: "20-30 min",
    hq: false,
    desc: "Service express à La Chasse, Jourdan, Quartier Européen, Merode et Arsenal."
  },
  {
    name: "Ixelles",
    zip: "1050",
    slug: "ixelles",
    delay: "25-35 min",
    hq: false,
    desc: "Flagey, Châtelain, Matonge, Boondael, ULB/VUB et Cimetière d'Ixelles."
  },
  {
    name: "Schaerbeek",
    zip: "1030",
    slug: "schaerbeek",
    delay: "20-30 min",
    hq: false,
    desc: "Dépannage d'urgence quartier Meiser, Parc Josaphat, Plasky, Dailly et Gare du Nord."
  },
  {
    name: "Auderghem",
    zip: "1160",
    slug: "auderghem",
    delay: "20-30 min",
    hq: false,
    desc: "Herrmann-Debroux, Boulevard du Souverain, Rouge-Cloître et quartier Saint-Julien."
  },
  {
    name: "Evere",
    zip: "1140",
    slug: "evere",
    delay: "20-30 min",
    hq: false,
    desc: "Quartier Bordet, OTAN, Henri Dunant, Paduwa et Paepedelle."
  },
  {
    name: "Bruxelles-Ville & Pentagone",
    zip: "1000",
    slug: "bruxelles-ville",
    delay: "30-40 min",
    hq: false,
    desc: "Centre historique, Sablon, Marolles, Grand-Place, Quartier des Quais et Louise."
  },
  {
    name: "Uccle",
    zip: "1180",
    slug: "uccle",
    delay: "35-45 min",
    hq: false,
    desc: "Fort Jaco, Dieweg, Vert Chasseur, Vivier d'Oie, Saint-Job et Globe."
  },
  {
    name: "Kraainem & Wezembeek-Oppem",
    zip: "1950 / 1970",
    slug: "peripherie-est",
    delay: "20-30 min",
    hq: false,
    desc: "Communes limitrophes francophones et facilités de la périphérie est de Bruxelles."
  }
];
---

<Layout 
  title="Zones d'intervention Plomberie à Bruxelles & Woluwe-Saint-Lambert" 
  description="Piotrex intervient en urgence à Woluwe-Saint-Lambert (1200), Woluwe-Saint-Pierre (1150), Etterbeek, Ixelles, Schaerbeek et dans toute la région de Bruxelles-Capitale."
>
  <!-- Header -->
  <section class="section" style="padding-top: 4rem; padding-bottom: 2rem; border-bottom: 1px solid var(--border-subtle);">
    <div class="container text-center">
      <span class="badge-tag">Couverture Géographique</span>
      <h1 class="section-title">Zones d'Intervention à Bruxelles & Environs</h1>
      <p class="section-subtitle" style="max-width: 750px; margin: 0 auto;">
        Basée au cœur de <strong>Woluwe-Saint-Lambert</strong>, notre équipe mobile sillonne quotidiennement la Région de Bruxelles-Capitale pour répondre à toutes vos urgences plomberie et chauffage.
      </p>
    </div>
  </section>

  <!-- Local Headquarters Highlights -->
  <section class="section" style="background: rgba(17, 28, 52, 0.4);">
    <div class="container">
      <div style="background: linear-gradient(135deg, rgba(2, 132, 199, 0.15), rgba(7, 89, 133, 0.25)); border: 1px solid var(--border-accent); border-radius: var(--radius-lg); padding: 3rem;">
        <div style="display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 2.5rem; align-items: center;">
          <div>
            <span style="background: #0284c7; color: #fff; font-size: 0.75rem; font-weight: 700; padding: 0.25rem 0.75rem; border-radius: 999px; text-transform: uppercase;">
              Secteur Prioritaire
            </span>
            <h2 style="font-size: 2rem; font-weight: 800; margin: 1rem 0; color: #ffffff;">
              Plombier d'Urgence à Woluwe-Saint-Lambert (1200)
            </h2>
            <p style="color: var(--text-secondary); line-height: 1.7; margin-bottom: 1.5rem;">
              En tant que résidents et artisans actifs à Woluwe-Saint-Lambert, nous pouvons nous trouver chez vous en <strong>moins de 20 minutes</strong>. Que vous habitiez une maison unifamiliale le long du Boulevard Brand Whitlock ou un appartement près de Poséidon ou de la station Tomberg, Piotrex est votre premier recours.
            </p>
            <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
              <a href="tel:+32470123456" class="btn btn-emergency">Appeler notre dépanneur Woluwe</a>
              <a href="/contact" class="btn btn-secondary">Demande d'intervention</a>
            </div>
          </div>

          <div style="background: var(--bg-card); border-radius: var(--radius-md); padding: 2rem; border: 1px solid var(--border-subtle);">
            <h3 style="font-size: 1.15rem; font-weight: 700; color: #38bdf8; margin-bottom: 1rem;">Quartiers desservis à Woluwe-Saint-Lambert :</h3>
            <ul style="color: var(--text-secondary); line-height: 1.8; list-style: none;">
              <li>📍 Avenue Georges Henri & Verheyleweghen</li>
              <li>📍 Quartier Tomberg & Maison Communale</li>
              <li>📍 Roodebeek & Woluwe Shopping Center</li>
              <li>📍 Marcel Thiry & Cliniques Universitaires Saint-Luc</li>
              <li>📍 Quartier Gulledelle, Heydenberg & Hof ten Berg</li>
              <li>📍 Boulevard de la Woluwe & Vandervelde</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Communes Grid -->
  <section class="section">
    <div class="container">
      <div class="section-title-wrap">
        <span class="badge-tag">Toutes les Communes</span>
        <h2 class="section-title">Déplacements dans Bruxelles & Périphérie</h2>
        <p class="section-subtitle">
          Retrouvez les délais d'arrivée habituels de nos camionnettes équipées selon votre commune.
        </p>
      </div>

      <div class="cards-grid-3">
        {communes.map((c) => (
          <div class="card" id={c.slug}>
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem;">
              <div>
                <h3 class="card-title" style="margin-bottom: 0.25rem;">{c.name}</h3>
                <span style="font-size: 0.85rem; color: #38bdf8; font-weight: 600;">Code postal : {c.zip}</span>
              </div>
              <span style="background: rgba(2, 132, 199, 0.2); color: #38bdf8; padding: 0.3rem 0.6rem; border-radius: 999px; font-size: 0.75rem; font-weight: 700;">
                ⏱ {c.delay}
              </span>
            </div>
            <p class="card-desc">
              {c.desc}
            </p>
            <div style="margin-top: auto; border-top: 1px solid var(--border-subtle); padding-top: 1rem;">
              <a href={`tel:+32470123456`} class="btn btn-secondary" style="width: 100%; font-size: 0.85rem; justify-content: center;">
                Appeler pour {c.name}
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Emergency Dispatch Note -->
  <section class="section" style="background: rgba(17, 28, 52, 0.35); border-top: 1px solid var(--border-subtle);">
    <div class="container text-center">
      <div style="max-width: 700px; margin: 0 auto;">
        <h2 style="font-size: 1.85rem; font-weight: 800; margin-bottom: 1rem;">Votre commune n'est pas listée ?</h2>
        <p style="color: var(--text-secondary); margin-bottom: 2rem;">
          Nous couvrons l'ensemble des 19 communes de la région bruxelloise ainsi que le Brabant flamand et le Brabant wallon sur demande.
        </p>
        <a href="tel:+32470123456" class="btn btn-emergency">
          Vérifier la disponibilité en direct : 0470 12 34 56
        </a>
      </div>
    </div>
  </section>
</Layout>
